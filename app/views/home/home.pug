extends ../layout.pug

block append meta
  meta(name="og:title" content=__('proj_tagline') + ' | ' + __('proj_name') )
  meta(name="og:description" content=__('proj_description'))
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('proj_tagline') + ' | ' + __('proj_name')
  meta(name="description" content=__('proj_description'))
  meta(name="keywords" content=__('index.meta.keywords'))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  h1= __('home.title')
